# ==============================================================================
# PRD-01: REGISTRO COMO PROVEEDOR — CONFIGURACIÓN DE ENTORNO
# Periferia IT Group
# ==============================================================================

# Proveedor de Modelo de Lenguaje (Google Gemini Oficial SDK @google/genai)
# Clave privada de backend (NUNCA exponer en frontend, logs ni repositorio)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Modelo recomendado por eficiencia de costos y latencia: gemini-3.5-flash-lite
# Fallback compatible: gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Puerto HTTP del backend (Hono)
PORT=3000

# Parámetros de Protección y Costos del Agente Conversacional
MAX_AGENT_ITERATIONS=15
MAX_SESSION_TOKENS=50000
NODE_ENV=development

# Permitir sobrescritura de fecha de evaluación (SOLO en desarrollo/pruebas)
# En producción, debe ser false o estar ausente para forzar la fecha real del servidor
ALLOW_REFERENCE_DATE=false
